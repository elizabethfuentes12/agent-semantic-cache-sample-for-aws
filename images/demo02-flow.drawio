<mxfile host="app.diagrams.net" agent="drawio-skill" version="24.0.0">
<diagram name="Demo 02 — in-loop reasoning cache" id="demo02-flow">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="DEMO 02 — In-loop reasoning cache (LLM always generates)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The LLM ALWAYS runs under the CURRENT system prompt. Cached data enters the loop as context; the model adjusts and generates fresh. No prompt invalidation needed — savings are partial (40-85%), never 100%." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#52514e;" vertex="1" parent="1">
          <mxGeometry x="60" y="48" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="q" value="Question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="traj" value="Similar question seen before?&lt;div&gt;(KNN in Valkey node-based)&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="120" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hint" value="Append CACHED PLAN as context&lt;div&gt;&quot;these tool calls worked: geocode(Tokyo),&lt;br&gt;wikipedia(Visa policy of Japan)...&quot;&lt;/div&gt;&lt;div&gt;&lt;i&gt;BeforeInvocationEvent.messages&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="290" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="STRANDS AGENT LOOP — the LLM reasons under the CURRENT prompt, every time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=13;fontStyle=1;fontColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;container=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="500" height="330" as="geometry" />
        </mxCell>
        <mxCell id="model" value="LLM cycle: decide which tools to call&lt;div&gt;(with a plan hint: right tools on the&lt;br&gt;FIRST cycle — fewer reasoning cycles)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="toolq" value="Tool call:&lt;div&gt;exact same&lt;br&gt;(tool, args) cached?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="toolhit" value="Serve cached result&lt;div&gt;(tool NOT executed)&lt;/div&gt;&lt;div&gt;&lt;i&gt;BeforeToolCallEvent&lt;br&gt;.selected_tool&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="250" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="toolmiss" value="Execute real tool&lt;div&gt;(Duffel, Wikipedia,&lt;br&gt;Open-Meteo)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="355" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="LLM writes the final answer&lt;div&gt;fresh, under the CURRENT prompt&lt;br&gt;(language, tone, length all current)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="480" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="capture" value="Capture: store tool results (per-tool TTL: flights 5 min, geocode 30 d) + trajectory + cold-run token cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="480" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#009900;strokeWidth=2;" edge="1" parent="1" source="q" target="traj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#FF8000;strokeWidth=2;exitX=0.5;exitY=1;" edge="1" parent="1" source="traj" target="hint"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lyes2" value="yes" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315" y="245" width="36" height="18" as="geometry" /></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#009900;strokeWidth=2;exitX=1;exitY=0.5;" edge="1" parent="1" source="traj" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lno2" value="no → cold" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="465" y="155" width="80" height="18" as="geometry" /></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#FF8000;strokeWidth=2;exitX=1;exitY=0.5;" edge="1" parent="1" source="hint" target="model">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="330" /><mxPoint x="540" y="195" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#FF0000;strokeWidth=2;exitX=0.5;exitY=1;" edge="1" parent="1" source="model" target="toolq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#009900;strokeWidth=2;exitX=1;exitY=0.5;" edge="1" parent="1" source="toolq" target="toolhit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lyes3" value="yes" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="275" width="36" height="18" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#FF0000;strokeWidth=2;exitX=0.5;exitY=1;" edge="1" parent="1" source="toolq" target="toolmiss">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="390" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="lno3" value="no" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="715" y="378" width="30" height="18" as="geometry" /></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#0066CC;strokeWidth=2;exitX=0;exitY=0.5;" edge="1" parent="1" source="toolq" target="answer">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="320" /><mxPoint x="590" y="440" /><mxPoint x="715" y="440" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="ldone" value="results back to model → answer" style="text;html=1;strokeColor=none;fillColor=#ffffff;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="200" height="18" as="geometry" /></mxCell>
        <mxCell id="f9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;flowAnimation=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="answer" target="capture"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="measured2" value="Measured (New Zealand pair): cold 5 cycles / 7,000 tokens → warm 2 cycles / 2,965 tokens (4,035 saved), 3 tool cache hits, 0 real executions. The answer is ALWAYS fresh — cached context in, current-prompt generation out." style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=1;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="key" value="KEY DIFFERENCE vs Demo 01: here cached data is INPUT to the LLM (your 'adjust' design) — in Demo 01 the cached answer IS the output and the LLM never runs. That is why Demo 01 saves 100% but is prompt-sensitive, and Demo 02 saves 40-85% but is prompt-independent." style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;rounded=1;fontSize=12;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="780" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
</diagram>
</mxfile>
