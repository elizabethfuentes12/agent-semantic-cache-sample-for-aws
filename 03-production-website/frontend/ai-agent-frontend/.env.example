# Fill from the 03-backend stack outputs / SSM after deploy, then copy to .env
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_APPSYNC_EVENTS_ENDPOINT=
VITE_S3_UPLOAD_BUCKET=
# agent_arn: value of SSM /semantic-cache/agent-runtime-arn (written by stack 02)
VITE_AGENT_LIST={"agents": [{"path": "/travel", "name": "Travel Agent", "agentId": "SemanticCacheTravelAgent", "description": "Travel agent with Valkey semantic + reasoning cache", "agent_arn": "<AGENT_RUNTIME_ARN>"}]}
VITE_MODEL_LIST={"models":[{"name":"Nova Lite","id":"us.amazon.nova-lite-v1:0","selected":true}]}
